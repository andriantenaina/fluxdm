    {
      "name": "Doodstream",
      "hosts": ["(^|\\.)dood", "d0000d", "d000d", "ds2play", "ds2video", "doods\\.", "dooood", "do0od", "vide0\\.net", "dsvplay", "myvidplay", "playmogo", "dood-hd", "doodcdn", "d-s\\.io", "all3do", "vidply"],
      "steps": [
        {"op": "replace", "var": "url", "pattern": "/(?:d|f|v)/", "with": "/e/"},
        {"op": "fetch", "url": "{url}"},
        {"op": "jsredirect"},
        {"op": "regex", "pattern": "<title>([^<]+)</title>", "group": 1, "var": "title", "optional": true},
        {"op": "regex", "pattern": "/pass_md5/[^'\"\\s]+", "group": 0, "var": "pass"},
