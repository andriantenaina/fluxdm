        {"op": "regex", "pattern": "sources:\\s*\\[\\s*\"([^\"]+)\"", "group": 1, "var": "media", "optional": true},
        {"op": "regex", "pattern": "(https?://[^'\"\\s]+\\.(?:mp4|m3u8)[^'\"\\s]*)", "group": 1, "var": "media", "unless": "media"},
        {"op": "regex", "pattern": "<h1[^>]*>([^<]+)</h1>", "group": 1, "var": "title", "optional": true}
