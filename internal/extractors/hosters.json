        {"op": "regex", "var": "token", "source": "pass", "pattern": "([A-Za-z0-9]+)$", "group": 1, "unless": "token"},
        {"op": "fetch", "url": "{origin}{pass}", "to": "base", "referer": "{url}"},
        {"op": "template", "value": "{base}{random10}?token={token}&expiry={now_ms}", "to": "media"}
      ],
      "headers": {"Referer": "{origin}/"}
    },
    {
      "name": "Uqload",
