{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "FluxDM",
  "description": "__MSG_extDesc__",
  "version": "0.3.0",
  "default_locale": "fr",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FluxDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "downloads",
    "webRequest",
    "webNavigation",
    "nativeMessaging",
    "contextMenus",
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "102",
  "browser_specific_settings": {
    "gecko": {
      "id": "fluxdm@fluxdm.local",
      "strict_min_version": "121.0"
    }
  }
}
